#!/usr/bin/env python3
"""Entry point for `loopctl`. Works when run directly, through a symlink (the environments' setup scripts link it
into /usr/local/bin) and under `python3 -I`: it puts the repository root first on sys.path and drops the caller's
working directory, so nothing from the current directory can shadow the engine."""

import os
import sys

if sys.version_info < (3, 11):
    sys.exit(f"loopctl needs Python 3.11 or newer, found {sys.version.split()[0]}")

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
CWD = os.getcwd()
sys.path[:] = [ROOT] + [p for p in sys.path if p not in ("", ".", CWD, ROOT)]

from loopctl.cli import main  # noqa: E402

sys.exit(main())
