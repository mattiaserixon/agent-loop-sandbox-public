      "revert"
     ]
    },
    "lease_token_sha256": {
     "pattern": "^[0-9a-f]{64}$",
     "type": "string"
    }
   },
   "required": [
    "attempt",
    "expires_at",
    "holder_session",
    "kind",
    "lease_token_sha256"
   ],
   "type": "object"
  },
  "lease.released": {
   "additionalProperties": false,
