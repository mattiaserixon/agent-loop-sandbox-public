        },
        {
         "type": "null"
        }
       ],
       "description": "the gate worker's session when the controller has bound it, else null"
      },
      "tested": {
       "pattern": "^[0-9a-f]{40}$",
       "type": "string"
      },
      "tested_tree": {
       "description": "the tree of T (H squashed onto base): main's tree after the merge must equal it (I3)",
       "pattern": "^[0-9a-f]{40}$",
       "type": "string"
      }
     },
     "required": [
      "base",
      "finished_at",
      "gate_command_sha256",
      "head",
      "log_sha256",
      "result",
      "session",
      "tested"
     ],
     "type": "object"
    }
   },
   "required": [
    "result"
   ],
   "type": "object"
  },
  "main.moved": {
   "additionalProperties": false,
   "description": "the controller saw main move: its sha is unchecked until a post-merge check (§10.6) passes on it",
