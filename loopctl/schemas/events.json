{
 "description": "Events: immutable files events/YYYY/MM/DD/<ulid>-<writer>.json (phase2-design §5.1). id and at are written by loopctl.",
 "envelope": {
  "additionalProperties": false,
  "properties": {
   "at": {
    "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$",
    "type": "string",
    "x-stamped": true
   },
   "cid": {
    "pattern": "^[a-z]+-[0-9a-f]{1,12}#[0-9]{1,4}$|^controller$",
    "type": "string"
   },
   "claimant_sha256": {
    "anyOf": [
     {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "sha256 of the session that claimed the lease with its first call (decision record 0029, loopctl/claim.py)"
   },
   "epoch": {
    "minimum": 1,
    "type": [
     "integer",
     "null"
    ]
   },
   "id": {
    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
    "type": "string",
    "x-stamped": true
   },
   "lease_token": {
    "anyOf": [
     {
      "pattern": "^[0-9a-f]{32}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "the unit's lease token (decision record 0029), presented by a worker; checked against the lease's sha256"
   },
   "payload": {
    "type": "object"
   },
   "type": {
    "enum": [
     "approval.recorded",
     "command.applied",
     "command.received",
     "command.rejected",
     "controller.alert",
     "controller.lease",
     "cost.observed",
     "event.restamped",
     "finding.fixed",
     "finding.reopened",
     "finding.waived",
     "fix.pushed",
     "gate.failed",
     "gate.passed",
     "issue.seen",
     "lease.bound",
     "lease.expired",
     "lease.granted",
     "lease.released",
     "lease.renewed",
     "limit.observed",
     "main.checked",
     "main.moved",
     "merge.audited",
     "merge.done",
     "merge.requested",
     "pr.head",
     "pr.risk",
     "pr.seen",
     "question.answered",
     "question.opened",
     "reconcile.due",
     "reconcile.reported",
     "revert.due",
     "revert.pushed",
     "review.submitted",
     "stop.seen",
     "tick.done",
     "triage.done",
     "unit.closed"
    ]
   },
   "unit": {
    "anyOf": [
     {
      "pattern": "^(issue|pr|scan|build|reconcile)-[0-9]{1,8}$|^(check|revert)-[0-9a-f]{12}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "writer": {
    "pattern": "^(controller|worker:(fix|review|gate|triage|scan|build|reconcile|check|revert)|owner|workflow)$",
    "type": "string"
   }
  },
  "required": [
   "at",
   "cid",
   "epoch",
   "id",
   "payload",
   "type",
   "unit",
   "writer"
  ],
  "type": "object"
 },
 "payloads": {
  "approval.recorded": {
   "additionalProperties": false,
   "description": "an owner approval of head, from an App-authored verified commit (§10.4, M0.7)",
   "properties": {
    "confirmation": {
     "pattern": "^[0-9a-f]{40}$",
     "type": "string"
    },
    "head": {
     "pattern": "^[0-9a-f]{40}$",
     "type": "string"
    }
   },
   "required": [
    "confirmation",
    "head"
   ],
   "type": "object"
  },
  "command.applied": {
   "additionalProperties": false,
   "properties": {
    "command_id": {
     "type": "string"
    },
    "config_hash_after": {
     "pattern": "^[0-9a-f]{64}$",
     "type": "string"
    },
    "config_hash_before": {
     "pattern": "^[0-9a-f]{64}$",
     "type": "string"
    },
    "verdict": {
     "enum": [
      "in_effect",
      "applied_later_changed",
      "applied_differently",
      "awaiting_confirmation",
      "replaced_before_confirmation"
     ]
    }
   },
   "required": [
    "command_id",
    "config_hash_after",
    "config_hash_before",
    "verdict"
   ],
   "type": "object"
  },
  "command.received": {
   "additionalProperties": false,
   "properties": {
    "command": {
     "additionalProperties": false,
     "description": "An owner command as the page writes it (phase2-design §12.2–12.3).",
     "properties": {
      "args": {
       "type": "object"
      },
      "client_time": {
       "description": "the owner's browser clock; orders the owner's own commands (§12.3), never stored as a loop time",
       "maxLength": 40,
       "type": "string",
       "x-owner-clock": true
      },
      "expected_hash": {
       "anyOf": [
        {
         "pattern": "^[0-9a-f]{64}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "pattern": "^[A-Za-z0-9_-]{4,64}$",
       "type": "string"
      },
      "nonce": {
       "maxLength": 128,
       "minLength": 8,
       "type": "string"
      },
      "type": {
       "enum": [
        "mode",
        "pause",
        "resume",
        "stop",
        "set",
        "order",
        "order_append",
        "run",
        "exclude_label",
        "include_label",
        "approve",
        "merge",
        "waive",
        "answer",
        "retry",
        "release",
        "reassign",
        "close",
        "promote_note",
        "dismiss_note",
        "meter",
        "tick_now"
       ]
      }
     },
     "required": [
      "args",
      "client_time",
      "id",
      "nonce",
      "type"
     ],
     "type": "object"
    }
   },
   "required": [
    "command"
   ],
   "type": "object"
  },
  "command.rejected": {
   "additionalProperties": false,
   "properties": {
    "command_id": {
     "type": "string"
    },
    "reason": {
     "maxLength": 300,
     "type": "string"
    }
   },
   "required": [
    "command_id",
    "reason"
   ],
   "type": "object"
  },
  "controller.alert": {
   "additionalProperties": false,
   "description": "a needs-you item from a tick that may not write state (self-check failed, two controllers): the holder's next tick opens it as a question",
   "properties": {
    "problem": {
     "maxLength": 500,
     "minLength": 1,
     "type": "string"
    },
    "session": {
     "anyOf": [
      {
       "pattern": "^session_[A-Za-z0-9]{8,64}$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "problem",
    "session"
   ],
   "type": "object"
  },
  "controller.lease": {
   "additionalProperties": false,
   "properties": {
    "environment": {
     "pattern": "^env_[A-Za-z0-9]{8,64}$",
     "type": "string"
    },
    "epoch": {
     "minimum": 1,
     "type": "integer"
    },
    "expires_at": {
     "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$",
     "type": "string",
     "x-stamped": true
    },
    "granted_at": {
     "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$",
     "type": "string",
     "x-stamped": true
    },
    "reason": {
     "enum": [
      "first",
      "renew",
      "expired",
      "holder_gone"
     ]
    },
    "session": {
     "pattern": "^session_[A-Za-z0-9]{8,64}$",
     "type": "string"
    },
    "tick_task": {
     "pattern": "^trig_[A-Za-z0-9]{8,64}$",
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "environment",
    "epoch",
    "expires_at",
    "granted_at",
    "reason",
    "session",
    "tick_task"
   ],
   "type": "object"
  },
  "cost.observed": {
   "additionalProperties": false,
   "properties": {
    "final": {
     "type": "boolean"
    },
    "session": {
     "pattern": "^session_[A-Za-z0-9]{8,64}$",
     "type": "string"
    },
    "usd": {
     "minimum": 0,
     "type": "number"
    }
   },
   "required": [
    "final",
    "session",
    "usd"
   ],
   "type": "object"
  },
  "event.restamped": {
   "additionalProperties": false,
   "description": "T-TIME (0013): an event file whose time was more than 2 minutes off the controller's clock when the tick folded it; the reducer applies that event with this event's own time (the controller's) instead. written_at is the event file's own stamp, kept for the record.",
   "properties": {
    "event": {
     "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
     "type": "string"
    },
    "written_at": {
     "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$",
     "type": "string",
     "x-stamped": true
    }
   },
   "required": [
    "event",
    "written_at"
   ],
   "type": "object"
  },
  "finding.fixed": {
   "additionalProperties": false,
   "properties": {
    "commit": {
     "pattern": "^[0-9a-f]{40}$",
     "type": "string"
    },
    "finding_id": {
     "pattern": "^f-[0-9A-HJKMNP-TV-Z]{26}$",
     "type": "string"
    },
    "test": {
     "maxLength": 300,
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "commit",
    "finding_id",
    "test"
   ],
   "type": "object"
  },
  "finding.reopened": {
   "additionalProperties": false,
   "properties": {
    "finding_id": {
     "pattern": "^f-[0-9A-HJKMNP-TV-Z]{26}$",
     "type": "string"
    },
    "reason": {
     "maxLength": 300,
     "type": "string"
    }
   },
   "required": [
    "finding_id",
    "reason"
   ],
   "type": "object"
  },
  "finding.waived": {
   "additionalProperties": false,
   "properties": {
    "confirmation": {
     "pattern": "^[0-9a-f]{40}$",
     "type": "string"
    },
    "finding_id": {
     "pattern": "^f-[0-9A-HJKMNP-TV-Z]{26}$",
     "type": "string"
    }
   },
   "required": [
    "confirmation",
    "finding_id"
   ],
   "type": "object"
  },
  "fix.pushed": {
   "additionalProperties": false,
   "properties": {
    "head": {
     "pattern": "^[0-9a-f]{40}$",
     "type": "string"
    },
    "pr": {
     "minimum": 1,
     "type": "integer"
    }
   },
   "required": [
    "head",
    "pr"
   ],
   "type": "object"
  },
  "gate.failed": {
   "additionalProperties": false,
   "properties": {
    "attributed": {
     "type": "boolean"
    },
    "result": {
     "additionalProperties": false,
     "description": "gate/<head>.json in the state repo (phase2-design §9.4). finished_at is written by loopctl.",
     "properties": {
      "base": {
       "pattern": "^[0-9a-f]{40}$",
       "type": "string"
      },
      "command": {
       "description": "the gate command run (from main's .agent-loop.toml)",
       "maxLength": 500,
       "type": "string"
      },
      "finished_at": {
       "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$",
       "type": "string",
       "x-stamped": true
      },
      "gate_command_sha256": {
       "pattern": "^[0-9a-f]{64}$",
       "type": "string"
      },
      "head": {
       "pattern": "^[0-9a-f]{40}$",
       "type": "string"
      },
      "log_sha256": {
       "pattern": "^[0-9a-f]{64}$",
       "type": "string"
      },
      "result": {
       "enum": [
        "pass",
        "fail"
       ]
      },
      "session": {
       "anyOf": [
        {
         "pattern": "^session_[A-Za-z0-9]{8,64}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "the gate worker's session when the controller has bound it, else null"
      },
      "tested": {
       "pattern": "^[0-9a-f]{40}$",
       "type": "string"
      },
      "tested_tree": {
       "description": "the tree of T (H squashed onto base): main's tree after the merge must equal it (I3)",
       "pattern": "^[0-9a-f]{40}$",
       "type": "string"
      }
     },
     "required": [
      "base",
      "finished_at",
      "gate_command_sha256",
      "head",
      "log_sha256",
      "result",
      "session",
      "tested"
     ],
     "type": "object"
    }
   },
   "required": [
    "attributed",
    "result"
   ],
   "type": "object"
  },
  "gate.passed": {
   "additionalProperties": false,
   "properties": {
    "result": {
     "additionalProperties": false,
     "description": "gate/<head>.json in the state repo (phase2-design §9.4). finished_at is written by loopctl.",
     "properties": {
      "base": {
       "pattern": "^[0-9a-f]{40}$",
       "type": "string"
      },
      "command": {
       "description": "the gate command run (from main's .agent-loop.toml)",
       "maxLength": 500,
       "type": "string"
      },
      "finished_at": {
       "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$",
       "type": "string",
       "x-stamped": true
      },
      "gate_command_sha256": {
       "pattern": "^[0-9a-f]{64}$",
       "type": "string"
      },
      "head": {
       "pattern": "^[0-9a-f]{40}$",
       "type": "string"
      },
      "log_sha256": {
       "pattern": "^[0-9a-f]{64}$",
       "type": "string"
      },
      "result": {
       "enum": [
        "pass",
        "fail"
       ]
      },
      "session": {
       "anyOf": [
        {
         "pattern": "^session_[A-Za-z0-9]{8,64}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "the gate worker's session when the controller has bound it, else null"
      },
      "tested": {
       "pattern": "^[0-9a-f]{40}$",
       "type": "string"
      },
      "tested_tree": {
       "description": "the tree of T (H squashed onto base): main's tree after the merge must equal it (I3)",
       "pattern": "^[0-9a-f]{40}$",
       "type": "string"
      }
     },
     "required": [
      "base",
      "finished_at",
      "gate_command_sha256",
      "head",
      "log_sha256",
      "result",
      "session",
      "tested"
     ],
     "type": "object"
    }
   },
   "required": [
    "result"
   ],
   "type": "object"
  },
  "issue.seen": {
   "additionalProperties": false,
   "properties": {
    "issue": {
     "minimum": 1,
     "type": "integer"
    }
   },
   "required": [
    "issue"
   ],
   "type": "object"
  },
  "lease.bound": {
   "additionalProperties": false,
   "properties": {
    "session": {
     "pattern": "^session_[A-Za-z0-9]{8,64}$",
     "type": "string"
    }
   },
   "required": [
    "session"
   ],
   "type": "object"
  },
  "lease.expired": {
